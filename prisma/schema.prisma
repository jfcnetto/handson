generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      String   @default("OPERATOR") // ADMIN or OPERATOR
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id                      String   @id @default(uuid())
  name                    String
  company                 String
  email                   String   @unique
  phone                   String?
  jobTitle                String?
  companySize             String?
  document                String?

  // Etapa 2
  targetSystem            String?
  hasSourceCode           String?
  technology              String?
  database                String?
  documentation           String?
  
  // Etapa 3
  knowledgeCentralization String?
  businessCriticality     String?
  motivation              String?
  urgency                 String?

  // Resultados calculados
  legacyComplexityScore   Int      @default(0)
  reverseEngineeringRisk  Int      @default(0)
  businessCriticalityScore Int     @default(0)
  leadIntentScore         Int      @default(0)
  
  estimatedRangeMin       Int?
  estimatedRangeMax       Int?
  recommendedService      String?
  
  status                  String   @default("NEW")

  closedValue             Float?
  maintenanceMrr          Float?
  prospectReason          String?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  transactions            Transaction[]
}

model Transaction {
  id          String   @id @default(uuid())
  description String
  amount      Float
  type        String   // "INCOME" or "EXPENSE"
  date        DateTime @default(now())
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PricingTier {
  id          String   @id @default(uuid())
  name        String
  minScore    Int
  maxScore    Int
  minValue    Float
  maxValue    Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

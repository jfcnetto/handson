generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      String   @default("OPERATOR") // ADMIN or OPERATOR
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id                      String   @id @default(uuid())
  name                    String
  company                 String
  email                   String   @unique
  phone                   String?
  jobTitle                String?
  companySize             String?

  // Etapa 2
  targetSystem            String?
  hasSourceCode           String?
  technology              String?
  database                String?
  documentation           String?
  
  // Etapa 3
  knowledgeCentralization String?
  businessCriticality     String?
  motivation              String?
  urgency                 String?

  // Resultados calculados
  legacyComplexityScore   Int      @default(0)
  reverseEngineeringRisk  Int      @default(0)
  businessCriticalityScore Int     @default(0)
  leadIntentScore         Int      @default(0)
  
  estimatedRangeMin       Int?
  estimatedRangeMax       Int?
  recommendedService      String?
  
  status                  String   @default("NEW")

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}
